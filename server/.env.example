# ======================
# CRITICAL: Database Configuration
# ======================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/pushsaas

# ======================
# CRITICAL: JWT Configuration
# ======================
# SECURITY: Generate a strong random secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# NEVER use a weak secret or the default value
# NEVER commit this value to git
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=24h

# ======================
# CRITICAL: VAPID Keys for Web Push
# ======================
# Generate VAPID keys with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ======================
# Server Configuration
# ======================
PORT=3000
NODE_ENV=development

# ======================
# Worker Threads Pool Configuration
# ======================
# Number of worker threads for campaign processing
# Recommended: 75% of CPU cores (e.g., 8 workers for 12 cores)
# Set to 0 or leave empty to auto-detect (will use CPU cores - 2)
# Min: 1, Max: number of CPU cores
WORKER_POOL_SIZE=8

# Maximum concurrent batches per worker
# Higher = more memory, faster processing
# Lower = less memory, more stable
WORKER_CONCURRENCY=2

# Batch size for notification sending
# Recommended: 500-1000 for best performance
# Higher = fewer DB operations but more memory
NOTIFICATION_BATCH_SIZE=1000

# ======================
# CORS Configuration
# ======================
# Comma-separated list of allowed origins
# Example: http://localhost:3001,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3001

# ======================
# Optional: Email Configuration (if using email features)
# ======================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ======================
# Optional: Redis Configuration (for caching/rate limiting)
# ======================
# REDIS_URL=redis://localhost:6379

# ======================
# Logging with Pino
# ======================
# Log level: fatal | error | warn | info | debug | trace
# Development default: debug
# Production default: info
LOG_LEVEL=info

# Optional: Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here
